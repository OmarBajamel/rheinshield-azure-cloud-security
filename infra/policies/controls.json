{
  "version": "1.0.0",
  "initiative": "RheinShield Security Baseline",
  "controls": {
    "RSP-001": {"name":"allowed-locations","displayName":"RheinShield - Allowed Azure regions","mode":"All","effect":"deny","frameworks":["BSIG §30","ISO A.5.23","MCSB PV-1"],"policyRule":{"if":{"allOf":[{"field":"location","notIn":"[parameters('allowedLocations')]"},{"field":"location","notEquals":"global"}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]},"allowedLocations":{"type":"Array","defaultValue":["germanywestcentral","westeurope"]}}},
    "RSP-002": {"name":"required-project-tag","displayName":"RheinShield - Require Project tag","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.5.9","MCSB AM-1"],"policyRule":{"if":{"field":"tags['Project']","notEquals":"RheinShield"},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-003": {"name":"required-lifecycle-tags","displayName":"RheinShield - Require owner, environment, classification and expiry tags","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.5.9","MCSB AM-2"],"policyRule":{"if":{"anyOf":[{"field":"tags['Owner']","exists":"false"},{"field":"tags['Environment']","exists":"false"},{"field":"tags['DataClassification']","exists":"false"},{"field":"tags['ExpiresAt']","exists":"false"}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-004": {"name":"storage-minimum-tls","displayName":"RheinShield - Storage requires TLS 1.2 or newer","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.8.24","MCSB DP-3"],"policyRule":{"if":{"allOf":[{"field":"type","equals":"Microsoft.Storage/storageAccounts"},{"field":"Microsoft.Storage/storageAccounts/minimumTlsVersion","notEquals":"TLS1_2"}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-005": {"name":"storage-secure-transfer","displayName":"RheinShield - Storage secure transfer required","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.8.24","MCSB DP-4"],"policyRule":{"if":{"allOf":[{"field":"type","equals":"Microsoft.Storage/storageAccounts"},{"field":"Microsoft.Storage/storageAccounts/supportsHttpsTrafficOnly","notEquals":true}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-006": {"name":"storage-disable-public-blob","displayName":"RheinShield - Disable public blob access","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.8.3","MCSB NS-2"],"policyRule":{"if":{"allOf":[{"field":"type","equals":"Microsoft.Storage/storageAccounts"},{"field":"Microsoft.Storage/storageAccounts/allowBlobPublicAccess","notEquals":false}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-007": {"name":"storage-public-network","displayName":"RheinShield - Assess storage public network access","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.8.20","MCSB NS-2"],"policyRule":{"if":{"allOf":[{"field":"type","equals":"Microsoft.Storage/storageAccounts"},{"field":"Microsoft.Storage/storageAccounts/publicNetworkAccess","notEquals":"Disabled"}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-008": {"name":"key-vault-rbac","displayName":"RheinShield - Key Vault uses Azure RBAC","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.5.15","MCSB PA-7"],"policyRule":{"if":{"allOf":[{"field":"type","equals":"Microsoft.KeyVault/vaults"},{"field":"Microsoft.KeyVault/vaults/enableRbacAuthorization","notEquals":true}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-009": {"name":"key-vault-purge-protection","displayName":"RheinShield - Key Vault purge protection enabled","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.8.13","MCSB DP-6"],"policyRule":{"if":{"allOf":[{"field":"type","equals":"Microsoft.KeyVault/vaults"},{"field":"Microsoft.KeyVault/vaults/enablePurgeProtection","notEquals":true}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-010": {"name":"restrict-public-ip","displayName":"RheinShield - Restrict public IP creation","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.8.20","MCSB NS-2"],"policyRule":{"if":{"field":"type","equals":"Microsoft.Network/publicIPAddresses"},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-011": {"name":"nsg-no-admin-from-internet","displayName":"RheinShield - NSG cannot expose SSH or RDP to Internet","mode":"All","effect":"deny","frameworks":["BSIG §30","ISO A.8.20","MCSB NS-1"],"policyRule":{"if":{"allOf":[{"field":"type","equals":"Microsoft.Network/networkSecurityGroups/securityRules"},{"field":"Microsoft.Network/networkSecurityGroups/securityRules/access","equals":"Allow"},{"field":"Microsoft.Network/networkSecurityGroups/securityRules/direction","equals":"Inbound"},{"field":"Microsoft.Network/networkSecurityGroups/securityRules/sourceAddressPrefix","in":["*","Internet","0.0.0.0/0"]},{"field":"Microsoft.Network/networkSecurityGroups/securityRules/destinationPortRange","in":["22","3389","*"]}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-012": {"name":"require-managed-identity","displayName":"RheinShield - Supported compute uses managed identity","mode":"Indexed","effect":"audit","frameworks":["BSIG §30","ISO A.5.16","MCSB IM-3"],"policyRule":{"if":{"allOf":[{"field":"type","in":["Microsoft.App/containerApps","Microsoft.Web/sites","Microsoft.Compute/virtualMachines"]},{"field":"identity.type","exists":"false"}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}},
    "RSP-013": {"name":"require-diagnostic-settings","displayName":"RheinShield - Audit diagnostic settings","mode":"All","effect":"auditIfNotExists","frameworks":["BSIG §30","ISO A.8.15","MCSB LT-3"],"policyRule":{"if":{"field":"type","in":["Microsoft.KeyVault/vaults","Microsoft.Storage/storageAccounts","Microsoft.Network/networkSecurityGroups"]},"then":{"effect":"auditIfNotExists","details":{"type":"Microsoft.Insights/diagnosticSettings","existenceCondition":{"field":"Microsoft.Insights/diagnosticSettings/workspaceId","exists":"true"}}}},"parameters":{}},
    "RSP-014": {"name":"deny-shared-key-storage","displayName":"RheinShield - Disable storage shared-key authorization","mode":"Indexed","effect":"deny","frameworks":["BSIG §30","ISO A.5.17","MCSB IM-1"],"policyRule":{"if":{"allOf":[{"field":"type","equals":"Microsoft.Storage/storageAccounts"},{"field":"Microsoft.Storage/storageAccounts/allowSharedKeyAccess","notEquals":false}]},"then":{"effect":"[parameters('effect')]"}},"parameters":{"effect":{"type":"String","defaultValue":"Audit","allowedValues":["Audit","Deny","Disabled"]}}}
  }
}
